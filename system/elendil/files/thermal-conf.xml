<?xml version="1.0"?>
  <!--
    vi: ts=2 sw=2
  -->
 <!-- BEGIN -->
 <ThermalConfiguration>
 <Platform>
  <Name>Intel 10th Generation</Name>
  <ProductName>*</ProductName>
  <Preference>QUIET</Preference>
  <ThermalZones>
    <ThermalZone>
      <Type>cpu</Type>
      <TripPoints>
        <TripPoint>
          <SensorType>x86_pkg_temp</SensorType>
          <Temperature>65000</Temperature>
          <type>passive</type>
          <ControlType>SEQUENTIAL</ControlType>
          <CoolingDevice>
            <index>1</index>
            <Type>rapl_controller</Type>
            <SamplingPeriod>5</SamplingPeriod>
            <influence>100</influence>
          </CoolingDevice>
          <CoolingDevice>
            <Type>intel_powerclamp</Type>
            <SamplingPeriod>5</SamplingPeriod>
            <influence>90</influence>
            </CoolingDevice>
          <CoolingDevice>
            <Type>cpufreq</Type>
            <SamplingPeriod>5</SamplingPeriod>
            <influence>50</influence>
          </CoolingDevice>
          <CoolingDevice>
            <Type>Processor</Type>
            <SamplingPeriod>5</SamplingPeriod>
            <influence>50</influence>
          </CoolingDevice>
          <CoolingDevice>
            <Type>intel_pstate</Type>
            <SamplingPeriod>5</SamplingPeriod>
            <influence>30</influence>
          </CoolingDevice>
          <CoolingDevice>
            <Type>TCC</Type>
            <SamplingPeriod>5</SamplingPeriod>
            <influence>10</influence>
          </CoolingDevice>
        </TripPoint>
      </TripPoints>
    </ThermalZone>
  </ThermalZones>
</Platform>
</ThermalConfiguration>
<!-- END -->

